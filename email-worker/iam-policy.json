{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadContactList",
      "Effect": "Allow",
      "Action": ["ses:ListContacts", "ses:GetContactList"],
      "Resource": "arn:aws:ses:us-east-2:217828988640:contact-list/void-ultimate"
    },
    {
      "Sid": "SendFromVoidIdentity",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": [
        "arn:aws:ses:us-east-2:217828988640:identity/voidultimate.com",
        "arn:aws:ses:us-east-2:217828988640:identity/no-reply@voidultimate.com",
        "arn:aws:ses:us-east-2:217828988640:contact-list/void-ultimate"
      ]
    },
    {
      "Sid": "ReadSendQuota",
      "Effect": "Allow",
      "Action": ["ses:GetAccount"],
      "Resource": "*"
    },
    {
      "Sid": "SendJobs",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:UpdateItem"],
      "Resource": "arn:aws:dynamodb:us-east-2:217828988640:table/VoidEmailSends"
    },
    {
      "Sid": "SendRecipients",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:Query"],
      "Resource": "arn:aws:dynamodb:us-east-2:217828988640:table/VoidEmailSendRecipients"
    },
    {
      "Sid": "ReadNewsletters",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem"],
      "Resource": "arn:aws:dynamodb:us-east-2:217828988640:table/VoidNewsletters"
    },
    {
      "Sid": "WriteAudit",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem"],
      "Resource": "arn:aws:dynamodb:us-east-2:217828988640:table/VoidAuditLogs"
    },
    {
      "Sid": "SelfReinvoke",
      "Effect": "Allow",
      "Action": ["lambda:InvokeFunction"],
      "Resource": "arn:aws:lambda:us-east-2:217828988640:function:void-email-worker"
    }
  ]
}
